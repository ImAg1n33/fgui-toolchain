// FairyGUI Agent Bridge - editor-side plugin
//
// Runs a localhost HTTP JSON endpoint inside the FairyGUI editor so that AI
// agents (via CLI or MCP) can drive the editor: create components, insert
// objects, set properties, and publish packages - all through official
// editor APIs (undo-aware) with byte-identical publish output.
//
// Threading model: strictly single-threaded. HttpListener.BeginGetContext
// is polled per frame (IsCompleted), so every request is accepted, executed
// and answered on the main Unity thread. No JS ever runs off-thread.
//
// Endpoint: http://localhost:<port>/   (default 7531, override via port.txt
// next to this file)
// Protocol: POST with JSON body  {"cmd": "<command>", "args": {...}}
// Response: JSON {"ok": true, "data": ...} or {"ok": false, "error": "..."}

var VERSION = "0.4.2";

var FairyGUI = CS.FairyGUI;
var FairyEditor = CS.FairyEditor;
var App = FairyEditor.App;

// ---------------- logger ----------------

var PluginDir = App.pluginManager.basePath + "/agent-bridge";
var Bridge = {
    listener: null,
    pendingAccept: null,   // IAsyncResult of BeginGetContext
    queue: [],             // [{ctx, cmd, args}]
    current: null,         // command being executed across frames (publish)
    logLines: []
};

function plog(msg) {
    Bridge.logLines.push("[" + new Date().toISOString() + "] " + msg);
    if (Bridge.logLines.length > 500) Bridge.logLines.shift();
    console.log("[agent-bridge] " + msg);
    try {
        CS.System.IO.File.WriteAllText(
            PluginDir + "/bridge.log",
            Bridge.logLines.join("\n"));
    } catch (e) { /* disk issues must never break the server */ }
}

function readPort() {
    try {
        var s = CS.System.IO.File.ReadAllText(PluginDir + "/port.txt").trim();
        var p = parseInt(s, 10);
        if (p > 0 && p < 65536) return p;
    } catch (e) { }
    return 7531;
}

// ---------------- helpers ----------------

function ok(data) { return { ok: true, data: data === undefined ? null : data }; }
function fail(msg) { return { ok: false, error: String(msg) }; }

function getPkg(nameOrId) {
    var p = App.project.GetPackageByName(String(nameOrId));
    if (p == null) p = App.project.GetPackage(String(nameOrId));
    if (p == null) throw "package not found: " + nameOrId;
    // packages are lazily loaded: the item tree (rootItem.children) is only
    // populated after EnsureOpen, otherwise it looks empty
    try { if (!p.opened) p.EnsureOpen(); } catch (e) { plog("EnsureOpen(" + nameOrId + "): " + e); }
    return p;
}

function itemUrl(pkg, item) {
    // Encoded item URLs reserve exactly eight characters for the package ID.
    // A short handmade package ID silently eats the beginning of the item ID.
    if (String(pkg.id).length !== 8) {
        throw "invalid package id '" + pkg.id + "' in package '" + pkg.name +
            "': FairyGUI encoded URLs require 8 characters; repair package.xml and its ui:// references before editing";
    }
    return "ui://" + pkg.id + item.id;
}

function findItem(pkg, name, recursiveFrom) {
    var root = recursiveFrom || pkg.rootItem;
    if (root == null || root.name === name) return root;
    var ch = root.children;
    if (ch == null) return null;
    for (var i = 0; i < ch.Count; i++) {
        var r = findItem(pkg, name, ch.get_Item(i));
        if (r != null) return r;
    }
    return null;
}

function requireComponentItem(pkg, compName) {
    var it = findItem(pkg, compName);
    if (it == null) throw "component not found in package '" + pkg.name + "': " + compName;
    return it;
}

function ensureDocOpen(pkg, compName) {
    var item = requireComponentItem(pkg, compName);
    var url = itemUrl(pkg, item);
    var doc = App.docView.FindDocument(url);
    if (doc == null) {
        // Installed editor.d.ts declares URL overloads only, not FPackageItem.
        var attempts = [
            function () { return App.docView.OpenDocument(url, true); },
            function () { return App.docView.OpenDocument(url); },
        ];
        var lastErr = null;
        for (var i = 0; i < attempts.length && doc == null; i++) {
            try {
                doc = attempts[i]();
                if (doc == null) doc = App.docView.FindDocument(url);
            } catch (e) { lastErr = e; plog("OpenDocument#" + i + " " + compName + ": " + e); }
        }
        if (doc == null) throw "failed to open document: " + compName + (lastErr ? (" (last: " + lastErr + ")") : "");
    }
    return { doc: doc, item: item, url: url };
}

function itemInfo(pkg, item, depth) {
    var o = {
        id: item.id,
        name: item.name,
        type: item.type,
        path: item.path,
        exported: false,
        width: item.width,
        height: item.height
    };
    try { o.exported = item.exported; } catch (e) { }
    try { o.file = item.file; } catch (e) { }
    if (depth > 0) {
        o.children = [];
        var ch = null;
        try { ch = item.children; } catch (e) { ch = null; }
        if (ch != null) {
            var n = 0;
            try { n = ch.Count; } catch (e2) { n = 0; }
            for (var i = 0; i < n; i++) {
                o.children.push(itemInfo(pkg, ch.get_Item(i), depth - 1));
            }
        }
    }
    return o;
}

function propValueIn(v) {
    // pass-through: numbers/bools as-is, everything else as string
    return v;
}

// ---------------- command implementations (sync) ----------------

var COMMANDS = {};

COMMANDS.ping = function (a) {
    return ok({
        version: VERSION,
        editor: "FairyGUI",
        port: Bridge.port,
        projectPath: projectDirectory(),
        projectOpen: App.project != null,
        project: projectLabel()
    });
};

COMMANDS.project_info = function (a) {
    if (App.project == null) throw "no project open";
    var p = App.project;
    var d = { port: Bridge.port, packages: p.allPackages.Count, packageNames: [] };
    d.projectPath = projectDirectory();
    try { d.name = p.name; } catch (e) { }
    try { d.path = p.projectPath; } catch (e) { }
    for (var i = 0; i < p.allPackages.Count; i++) {
        d.packageNames.push(p.allPackages.get_Item(i).name);
    }
    return ok(d);
};

COMMANDS.list_packages = function (a) {
    if (App.project == null) throw "no project open";
    var arr = [];
    var ps = App.project.allPackages;
    for (var i = 0; i < ps.Count; i++) {
        var p = ps.get_Item(i);
        arr.push({ id: p.id, name: p.name, basePath: p.basePath });
    }
    return ok(arr);
};

COMMANDS.list_items = function (a) {
    var pkg = getPkg(a.pkg);
    return ok(itemInfo(pkg, pkg.rootItem, a.depth === undefined ? 3 : a.depth));
};

COMMANDS.read_component = function (a) {
    var pkg = getPkg(a.pkg);
    var item = requireComponentItem(pkg, a.name);
    return ok({
        name: item.name,
        url: itemUrl(pkg, item),
        xml: CS.System.IO.File.ReadAllText(item.file)
    });
};

COMMANDS.create_component = function (a) {
    var pkg = getPkg(a.pkg);
    if (String(pkg.id).length !== 8) itemUrl(pkg, { id: "" });
    if (!(a.width > 0 && a.height > 0)) throw "positive component width and height required";
    if (!a.name || findItem(pkg, String(a.name))) throw "component name missing or already exists: " + a.name;
    // both path and extentionId must be null (not "") when unused - the
    // empty string breaks internal dictionary lookups in CreateComponentItem
    var path = a.path ? String(a.path) : null;
    var exported = a.exported === undefined ? true : !!a.exported;
    var ext = a.extention ? String(a.extention) : null;
    var it = pkg.CreateComponentItem(String(a.name), a.width | 0, a.height | 0, path, ext, exported, false);
    pkg.Save();
    // Do not report a usable component until the editor can load its document.
    var opened = ensureDocOpen(pkg, it.name);
    return ok({ id: it.id, name: it.name, url: opened.url, file: it.file, openable: true });
};

COMMANDS.create_package = function (a) {
    if (App.project == null) throw "no project open";
    var name = a.name ? String(a.name) : "";
    if (!name) throw "args.name required";
    if (App.project.GetPackageByName(name) != null) throw "package already exists: " + name;
    var pkg = App.project.CreatePackage(name);
    if (pkg == null) throw "CreatePackage returned null for " + name;
    App.project.Save();
    try { if (!pkg.opened) pkg.EnsureOpen(); } catch (e) { plog("EnsureOpen(" + name + "): " + e); }
    if (String(pkg.id).length !== 8) {
        throw "CreatePackage produced invalid package id '" + pkg.id + "' (FairyGUI encoded URLs require 8 characters)";
    }
    return ok({ id: pkg.id, name: pkg.name, basePath: pkg.basePath });
};

// Write one complete component XML in a single call: text, list, defaultItem,
// controllers and gears are all in that XML. Closes an open document first so
// a later save_all cannot overwrite the file with stale editor memory.
COMMANDS.write_component = function (a) {
    if (!a.xml || typeof a.xml !== "string") throw "args.xml required (full <component> XML)";
    var xml = String(a.xml).replace(/^\uFEFF/, "");
    if (xml.indexOf("<component") < 0 || xml.indexOf("</component>") < 0) {
        throw "args.xml must be a full <component>...</component> document";
    }
    var pkg = getPkg(a.pkg);
    if (String(pkg.id).length !== 8) itemUrl(pkg, { id: "" });
    var baseName = componentBaseName(a.name);
    if (!baseName) throw "args.name required";
    var item = findComponentItem(pkg, baseName);
    var created = false;
    if (item == null) {
        var size = parseComponentSize(xml);
        var width = a.width > 0 ? (a.width | 0) : (size.width | 0);
        var height = a.height > 0 ? (a.height | 0) : (size.height | 0);
        if (!(width > 0 && height > 0)) throw "component size missing; set <component size=\"w,h\"> or args.width/height";
        var path = normalizeFolder(a.path);
        if (path) {
            try { pkg.EnsurePathExists(path, true); } catch (e1) {
                try { pkg.CreatePath(path); } catch (e2) { throw "failed to create folder " + path + ": " + e1; }
            }
        }
        var exported = a.exported === undefined ? true : !!a.exported;
        var ext = a.extention ? String(a.extention) : parseExtention(xml);
        item = pkg.CreateComponentItem(baseName, width, height, path, ext, exported, false);
        if (item == null) throw "CreateComponentItem returned null for " + baseName;
        pkg.Save();
        created = true;
    } else if (String(item.type).toLowerCase() !== "component") {
        throw "item exists but is not a component: " + baseName + " (" + item.type + ")";
    }
    var doc = App.docView.FindDocument(itemUrl(pkg, item));
    if (doc != null) App.docView.CloseDocument(doc);
    if (!item.file) throw "component has no file path: " + baseName;
    writeUtf8(String(item.file), xml);
    return ok({
        id: item.id,
        name: item.name,
        url: itemUrl(pkg, item),
        file: item.file,
        created: created,
        refreshRequired: true
    });
};

function componentBaseName(name) {
    var n = name ? String(name) : "";
    if (n.length > 4 && n.slice(-4).toLowerCase() === ".xml") n = n.slice(0, -4);
    return n;
}

function findComponentItem(pkg, baseName) {
    var it = findItem(pkg, baseName);
    if (it == null) it = findItem(pkg, baseName + ".xml");
    return it;
}

function parseComponentSize(xml) {
    var m = /<component\b[^>]*\bsize="(\d+(?:\.\d+)?)\s*,\s*(\d+(?:\.\d+)?)"/.exec(xml);
    if (!m) return { width: 0, height: 0 };
    return { width: parseFloat(m[1]), height: parseFloat(m[2]) };
}

function parseExtention(xml) {
    var m = /<component\b[^>]*\bextention="([^"]*)"/.exec(xml);
    if (!m || !m[1]) return null;
    return m[1];
}

function normalizeFolder(path) {
    if (!path) return null;
    var p = String(path).replace(/\\/g, "/");
    if (!p || p === "/") return null;
    if (p.charAt(0) !== "/") p = "/" + p;
    if (p.charAt(p.length - 1) !== "/") p = p + "/";
    return p;
}

function writeUtf8(path, text) {
    try {
        var enc = new CS.System.Text.UTF8Encoding(false);
        CS.System.IO.File.WriteAllText(path, text, enc);
    } catch (e) {
        CS.System.IO.File.WriteAllText(path, text);
    }
}

COMMANDS.delete_item = function (a) {
    var pkg = getPkg(a.pkg);
    var item = requireComponentItem(pkg, a.name);
    pkg.DeleteItem(item);
    pkg.Save();
    return ok({ deleted: a.name });
};

// Mark a library image as 9-slice. scale9grid is the center rectangle
// "left,top,width,height" in source pixels, the same attribute package.xml stores.
COMMANDS.set_image_scale9 = function (a) {
    var pkg = getPkg(a.pkg);
    var item = findItem(pkg, a.name);
    if (item == null && a.name) item = findItem(pkg, String(a.name).replace(/\.png$/i, "") + ".png");
    if (item == null) throw "image not found in package '" + pkg.name + "': " + a.name;
    if (String(item.type).toLowerCase() !== "image") throw "not an image: " + item.name + " (" + item.type + ")";
    var xmlPath = packageXmlPath(pkg);
    var xml = CS.System.IO.File.ReadAllText(xmlPath);
    var current = readImageScale(xml, item.id);
    if (current == null) throw "image id " + item.id + " not found in package.xml";
    if (current.scale === "9grid" && current.scale9grid && a.overwrite !== true) {
        return ok({
            id: item.id,
            name: item.name,
            scale: "9grid",
            scale9grid: current.scale9grid,
            already: true
        });
    }
    var size = imagePixelSize(item);
    var grid = resolveScale9Grid(a, size.width, size.height);
    var scale9 = grid.left + "," + grid.top + "," + grid.width + "," + grid.height;
    trySetImageScale9Memory(item, grid);
    xml = upsertImageScale9(xml, item.id, scale9);
    writeUtf8(xmlPath, xml);
    try { App.RefreshProject(); } catch (e) { plog("RefreshProject after scale9: " + e); }
    return ok({
        id: item.id,
        name: item.name,
        width: size.width,
        height: size.height,
        scale: "9grid",
        scale9grid: scale9,
        already: false
    });
};

function packageXmlPath(pkg) {
    var base = String(pkg.basePath || "").replace(/\\/g, "/");
    if (base.charAt(base.length - 1) === "/") base = base.slice(0, -1);
    return base + "/package.xml";
}

function imageTag(xml, id) {
    var re = new RegExp("<image\\b[^>]*\\bid=\"" + id + "\"[^>]*\\/?>");
    var m = re.exec(xml);
    return m ? m[0] : null;
}

function readImageScale(xml, id) {
    var tag = imageTag(xml, id);
    if (tag == null) return null;
    var scale = /\bscale="([^"]*)"/.exec(tag);
    var grid = /\bscale9grid="([^"]*)"/.exec(tag);
    return { scale: scale ? scale[1] : "", scale9grid: grid ? grid[1] : "" };
}

function upsertImageScale9(xml, id, scale9) {
    var tag = imageTag(xml, id);
    if (tag == null) throw "image id " + id + " not found in package.xml";
    var at = xml.indexOf(tag);
    var next = tag.replace(/\s+\bscale="[^"]*"/, "").replace(/\s+\bscale9grid="[^"]*"/, "");
    var attrs = " scale=\"9grid\" scale9grid=\"" + scale9 + "\"";
    if (/\/>$/.test(next)) next = next.replace(/\s*\/>$/, attrs + "/>");
    else next = next.replace(/>$/, attrs + ">");
    return xml.slice(0, at) + next + xml.slice(at + tag.length);
}

function imagePixelSize(item) {
    var w = item.width | 0;
    var h = item.height | 0;
    if (w > 0 && h > 0) return { width: w, height: h };
    if (!item.file) throw "image has no pixel size: " + item.name;
    var bytes = CS.System.IO.File.ReadAllBytes(String(item.file));
    if (bytes.Length < 24) throw "image file is not a readable png: " + item.name;
    function u32(o) {
        return ((bytes.get_Item(o) & 255) * 16777216) + ((bytes.get_Item(o + 1) & 255) * 65536)
            + ((bytes.get_Item(o + 2) & 255) * 256) + (bytes.get_Item(o + 3) & 255);
    }
    w = u32(16);
    h = u32(20);
    if (!(w > 0 && h > 0)) throw "could not read png size: " + item.name;
    return { width: w, height: h };
}

function resolveScale9Grid(a, imgW, imgH) {
    var left, top, width, height;
    if (a.scale9grid) {
        var p = String(a.scale9grid).split(",");
        if (p.length !== 4) throw "scale9grid must be left,top,width,height";
        left = parseInt(p[0], 10);
        top = parseInt(p[1], 10);
        width = parseInt(p[2], 10);
        height = parseInt(p[3], 10);
    } else if (a.left !== undefined || a.top !== undefined || a.width !== undefined || a.height !== undefined) {
        left = a.left | 0;
        top = a.top | 0;
        width = a.width | 0;
        height = a.height | 0;
    } else {
        left = Math.max(1, Math.floor(imgW / 3));
        top = Math.max(1, Math.floor(imgH / 3));
        width = imgW - left * 2;
        height = imgH - top * 2;
    }
    if (!(width > 0 && height > 0)) throw "scale9 center must be at least 1x1";
    if (left < 0 || top < 0 || left + width > imgW || top + height > imgH) {
        throw "scale9grid " + left + "," + top + "," + width + "," + height + " is outside " + imgW + "x" + imgH;
    }
    return { left: left, top: top, width: width, height: height };
}

function trySetImageScale9Memory(item, grid) {
    var rect = null;
    try { rect = new CS.UnityEngine.Rect(grid.left, grid.top, grid.width, grid.height); } catch (e) { rect = null; }
    if (rect == null) return;
    try { item.scale9Grid = rect; } catch (e1) { }
    try { item.scaleOption = 1; } catch (e2) { }
    try {
        var asset = item.GetAsset();
        if (asset != null) {
            try { asset.scale9Grid = rect; } catch (e3) { }
            try { asset.scale = "9grid"; } catch (e4) { }
        }
    } catch (e5) { }
}

COMMANDS.open_doc = function (a) {
    var pkg = getPkg(a.pkg);
    var r = ensureDocOpen(pkg, a.name);
    return ok({ opened: a.name, url: r.url });
};

COMMANDS.close_doc = function (a) {
    var pkg = getPkg(a.pkg);
    var item = requireComponentItem(pkg, a.name);
    var doc = App.docView.FindDocument(itemUrl(pkg, item));
    if (doc != null) App.docView.CloseDocument(doc);
    return ok({ closed: a.name });
};

COMMANDS.list_children = function (a) {
    var pkg = getPkg(a.pkg);
    var r = ensureDocOpen(pkg, a.name);
    var content = r.doc.content;
    var arr = [];
    var ch = content.children;
    for (var i = 0; i < ch.Count; i++) {
        var c = ch.get_Item(i);
        var o = { name: c.name };
        try { o.id = c.id; } catch (e) { }
        try { o.objType = c.objType; } catch (e) { }
        arr.push(o);
    }
    return ok({ component: a.name, children: arr });
};

// insert a library item (component/image/etc, referenced by url or pkg+name)
// into a component's stage
COMMANDS.insert_object = function (a) {
    var pkg = getPkg(a.pkg);
    var r = ensureDocOpen(pkg, a.name);
    var url = a.url || null;
    if (!url) {
        var refPkg = getPkg(a.ref_pkg || a.pkg);
        var refItem = requireComponentItem(refPkg, a.ref_name);
        url = itemUrl(refPkg, refItem);
    }
    var pos = null;
    if (a.x !== undefined && a.y !== undefined) {
        pos = new CS.UnityEngine.Vector2(a.x + 0.0, a.y + 0.0);
    }
    var obj;
    if (a.index === undefined) {
        obj = pos != null ? r.doc.InsertObject(url, pos) : r.doc.InsertObject(url);
    } else {
        obj = r.doc.InsertObject(url, pos, a.index | 0);
    }
    if (obj == null) throw "InsertObject returned null for url " + url;
    if (a.props) applyProps(obj, a.props);
    App.docView.SaveDocument(r.doc);
    return ok({ inserted: obj.name, url: url });
};

// Primitives (text, list, loader) are not library items. CreateChild runs on the
// open document's component, then SaveDocument persists that document.
COMMANDS.insert_text = function (a) {
    var opened = ensureDocOpen(getPkg(a.pkg), a.name);
    var attrs = {
        name: childName(a),
        xy: xyAttr(a),
        size: sizeAttr(a),
        text: a.text,
        fontSize: numAttr(a.fontSize),
        color: colorAttr(a.color),
        align: a.align,
        vAlign: a.vAlign,
        autoSize: a.autoSize,
        strokeColor: colorAttr(a.strokeColor),
        strokeSize: numAttr(a.strokeSize)
    };
    if (a.bold) attrs.bold = "true";
    if (a.singleLine) attrs.singleLine = "true";
    var obj = createOnDoc(opened.doc, "text", attrs, null);
    return finishChild(opened.doc, obj, a);
};

COMMANDS.insert_loader = function (a) {
    var pkg = getPkg(a.pkg);
    var opened = ensureDocOpen(pkg, a.name);
    var attrs = {
        name: childName(a),
        xy: xyAttr(a),
        size: sizeAttr(a),
        url: resolveRefUrl(pkg, a.refPkg, a.refName || a.ref_name, a.url),
        align: a.align,
        vAlign: a.vAlign,
        fill: a.fill
    };
    var obj = createOnDoc(opened.doc, "loader", attrs, null);
    return finishChild(opened.doc, obj, a);
};

COMMANDS.insert_list = function (a) {
    var pkg = getPkg(a.pkg);
    var opened = ensureDocOpen(pkg, a.name);
    var layout = listLayout(a.layout);
    var attrs = {
        name: childName(a),
        xy: xyAttr(a),
        size: sizeAttr(a),
        overflow: a.overflow || "hidden",
        layout: layout,
        lineGap: numAttr(a.lineGap),
        colGap: numAttr(a.colGap),
        lineItemCount: numAttr(a.lineItemCount),
        defaultItem: (a.defaultItem || a.url || a.refName || a.ref_name)
            ? resolveRefUrl(pkg, a.refPkg || a.ref_pkg, a.defaultItem || a.refName || a.ref_name, a.url)
            : null
    };
    var inner = "";
    var items = a.items || [];
    for (var i = 0; i < items.length; i++) {
        var it = items[i] || {};
        var icon = it.icon || it.url || null;
        if (icon && String(icon).indexOf("ui://") !== 0) {
            icon = resolveRefUrl(pkg, it.refPkg || a.refPkg, it.icon || it.refName, null);
        }
        inner += tagXml("item", { name: it.name, title: it.title, icon: icon }, true);
    }
    var obj = createOnDoc(opened.doc, "list", attrs, inner);
    return finishChild(opened.doc, obj, a);
};

COMMANDS.add_controller = function (a) {
    var opened = ensureDocOpen(getPkg(a.pkg), a.name);
    var controller = a.controller ? String(a.controller) : "";
    if (!controller) throw "args.controller required";
    var pages = a.pages;
    if (!pages || !pages.length) throw "args.pages required (array of page names)";
    var selected = a.selected === undefined ? 0 : (a.selected | 0);
    var xml = editorXml(tagXml("controller", {
        name: controller,
        pages: controllerPagesAttr(pages),
        selected: String(selected)
    }, true));
    opened.doc.AddController(xml);
    try { opened.doc.SetModified(true); } catch (e) { }
    App.docView.SaveDocument(opened.doc);
    return ok({ controller: controller, pages: pages.length, selected: selected });
};

COMMANDS.set_gear = function (a) {
    var opened = ensureDocOpen(getPkg(a.pkg), a.name);
    var target = a.target ? findChild(opened.doc.content, a.target) : null;
    if (target == null) throw "target not found: " + a.target;
    if (target.docElement == null) throw "target has no docElement: " + a.target;
    var gear = String(a.gear || "");
    var tag = gearTag(gear);
    var pkg = getPkg(a.pkg);
    var values = a.values;
    var valueAttr = null;
    if (values && values.length) {
        var parts = [];
        for (var i = 0; i < values.length; i++) {
            var v = values[i];
            if (gear === "icon" && v && String(v).indexOf("ui://") !== 0) {
                v = resolveRefUrl(pkg, a.refPkg, v, null);
            }
            parts.push(v == null ? "" : String(v));
        }
        valueAttr = parts.join("|");
    }
    var gearXml = tagXml(tag, {
        controller: a.controller,
        pages: pagesAttr(a.pages),
        values: valueAttr
    }, true);
    // UpdateGears wants the gear tag as the root. It can return ok without
    // writing the element, so also ReadGears from a parent node and save.
    var gearNode = editorXml(gearXml);
    if (target.docElement != null) {
        try { target.docElement.UpdateGears(gearNode); } catch (eGear) {
            plog("UpdateGears " + tag + ": " + eGear);
        }
    }
    var holder = FairyGUI.Utils.XML.Create("holder");
    holder.AppendChild(editorXml(gearXml));
    target.ReadGears(holder);
    try { opened.doc.SetModified(true); } catch (e2) { }
    App.docView.SaveDocument(opened.doc);
    return ok({ target: a.target, gear: gear, controller: a.controller });
};

function childName(a) {
    return a.child || a.objectName || null;
}

function numAttr(v) {
    if (v === undefined || v === null || v === "") return null;
    return String(v);
}

function colorAttr(c) {
    if (!c) return null;
    var s = String(c);
    if (s.charAt(0) !== "#") s = "#" + s;
    return s;
}

function xyAttr(a) {
    if (a.x === undefined || a.y === undefined) return null;
    return (a.x + 0) + "," + (a.y + 0);
}

function sizeAttr(a) {
    if (a.width === undefined || a.height === undefined) return null;
    return (a.width + 0) + "," + (a.height + 0);
}

function listLayout(layout) {
    if (!layout) return null;
    var s = String(layout);
    if (s === "单列" || s === "single_column" || s === "column") return null;
    if (s === "横向" || s === "row") return "row";
    if (s === "流式" || s === "flow" || s === "flow_hz") return "flow_hz";
    if (s === "flow_vt" || s === "竖向流式") return "flow_vt";
    if (s === "pagination") return "pagination";
    return s;
}

function pagesAttr(pages) {
    if (pages == null) return null;
    if (typeof pages === "string") return pages;
    if (!pages.length) return null;
    return pages.join(",");
}

function controllerPagesAttr(pages) {
    if (typeof pages === "string") return pages;
    var parts = [];
    for (var i = 0; i < pages.length; i++) {
        parts.push(String(i));
        parts.push(String(pages[i]));
    }
    return parts.join(",");
}

function gearTag(gear) {
    if (gear === "display" || gear === "gearDisplay") return "gearDisplay";
    if (gear === "text" || gear === "gearText") return "gearText";
    if (gear === "icon" || gear === "gearIcon") return "gearIcon";
    throw "args.gear must be display, text, or icon";
}

function xmlEscape(s) {
    return String(s)
        .replace(/&/g, "&amp;")
        .replace(/"/g, "&quot;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
}

function tagXml(tag, attrs, selfClose) {
    var parts = ["<" + tag];
    for (var k in attrs) {
        if (attrs[k] === undefined || attrs[k] === null || attrs[k] === "") continue;
        parts.push(" " + k + "=\"" + xmlEscape(attrs[k]) + "\"");
    }
    parts.push(selfClose ? "/>" : ">");
    return parts.join("");
}

function editorXml(s) {
    return new FairyGUI.Utils.XML(s);
}

function createOnDoc(doc, tag, attrs, inner) {
    if (!attrs) attrs = {};
    if (!attrs.id) {
        try { attrs.id = doc.content.GetNextId(); } catch (e) {
            throw "GetNextId failed before CreateChild <" + tag + ">: " + e;
        }
    }
    // Prefer XML.Create + SetAttribute. Parsing a raw string via new XML(s) can
    // yield a node CreateChild accepts but does not parent (empty name, no child).
    var xmlNode = null;
    try {
        xmlNode = FairyGUI.Utils.XML.Create(String(tag));
        for (var k in attrs) {
            if (attrs[k] === undefined || attrs[k] === null || attrs[k] === "") continue;
            xmlNode.SetAttribute(k, String(attrs[k]));
        }
        if (inner) {
            // list items etc: parse fragment children onto the node
            var wrap = editorXml("<wrap>" + inner + "</wrap>");
            var kids = wrap.Elements();
            if (kids != null) {
                var en = kids.GetEnumerator();
                while (en.MoveNext()) xmlNode.AppendChild(en.Current);
            }
        }
    } catch (eCreate) {
        plog("XML.Create path failed, fallback string: " + eCreate);
        var xmlStr = inner ? (tagXml(tag, attrs, false) + inner + "</" + tag + ">") : tagXml(tag, attrs, true);
        xmlNode = editorXml(xmlStr);
    }
    plog("CreateChild tag=" + tag + " id=" + attrs.id + " name=" + (attrs.name || ""));
    var obj = doc.content.CreateChild(xmlNode);
    if (obj != null && !obj.name) {
        try { doc.content.RemoveChild(obj, true); } catch (eRm) { }
        obj = null;
    }
    if (obj == null || !obj.name) {
        // CreateChild returns an unnamed object that never enters displayList.
        // Factory + AddChild is the path that actually serializes.
        try {
            var pkgItem = doc.packageItem;
            var pkg = pkgItem != null ? pkgItem.owner : null;
            if (pkg == null) throw "no package on document";
            obj = FairyEditor.FObjectFactory.CreateObject(pkg, fobjectType(tag));
            if (obj == null) throw "FObjectFactory.CreateObject returned null";
            doc.content.AddChild(obj);
            attachDocElement(doc, obj);
            applyChildAttrs(obj, attrs);
            plog("CreateChild fallback factory ok name=" + obj.name);
        } catch (eFall) {
            throw "CreateChild failed for <" + tag + "> and factory fallback failed: " + eFall;
        }
    }
    try { doc.content.UpdateDisplayList(true); } catch (e2) { }
    try { doc.content.ValidateChildren(false); } catch (e3) { }
    if (!obj.name) throw "CreateChild/factory produced unnamed object for <" + tag + ">";
    return obj;
}

function finishChild(doc, obj, a) {
    if (a.index !== undefined) doc.content.SetChildIndex(obj, a.index | 0);
    if (a.props) applyProps(obj, a.props);
    try { doc.SetModified(true); } catch (e) { }
    App.docView.SaveDocument(doc);
    var out = { name: obj.name };
    try { out.id = obj.id; } catch (e2) { }
    try { out.objType = obj.objType; } catch (e3) { }
    return ok(out);
}

function resolveRefUrl(currentPkg, refPkgName, refName, url) {
    if (url && String(url).indexOf("ui://") === 0) return String(url);
    var name = refName || (url ? String(url) : "");
    if (!name) throw "url or refName required";
    var refPkg = refPkgName ? getPkg(refPkgName) : currentPkg;
    var item = findItem(refPkg, name);
    if (item == null) item = findItem(refPkg, componentBaseName(name));
    if (item == null) item = findItem(refPkg, componentBaseName(name) + ".xml");
    if (item == null) throw "resource not found: " + name;
    return itemUrl(refPkg, item);
}

COMMANDS.set_property = function (a) {
    var pkg = getPkg(a.pkg);
    var r = ensureDocOpen(pkg, a.name);
    var target = a.target ? findChild(r.doc.content, a.target) : r.doc.content;
    if (target == null) throw "target not found: " + a.target;
    var props = a.props || null;
    if (props == null && a.prop !== undefined) props = {};
    if (props == null) throw "no props given (args.props={...} or args.prop/args.value)";
    if (a.prop !== undefined && props[a.prop] === undefined) props[a.prop] = a.value;
    var applied = applyProps(target, props);
    App.docView.SaveDocument(r.doc);
    return ok({ target: a.target || "$root", applied: applied });
};

COMMANDS.remove_object = function (a) {
    var pkg = getPkg(a.pkg);
    var r = ensureDocOpen(pkg, a.name);
    var target = findChild(r.doc.content, a.target);
    if (target == null) throw "target not found: " + a.target;
    r.doc.RemoveObject(target);
    App.docView.SaveDocument(r.doc);
    return ok({ removed: a.target });
};

COMMANDS.save_all = function (a) {
    App.docView.SaveAllDocuments();
    return ok({ saved: true });
};

COMMANDS.refresh = function (a) {
    App.RefreshProject();
    return ok({ refreshed: true });
};

COMMANDS.screenshot = function (a) {
    if (!a.path) throw "args.path required (absolute png path)";
    // 注意：被 Unity 裁剪的方法在 Jint 里可能暴露为 truthy 但不可调用，
    // typeof/真值守卫都会漏，必须 try/catch 实调
    var sc = null;
    try { sc = CS.UnityEngine.ScreenCapture; } catch (e) {}
    var last = null;
    if (sc) {
        try {
            sc.CaptureScreenshotAsFile(String(a.path)); // 同步写盘
            return ok({ screenshot: a.path });
        } catch (e1) { last = e1; plog("screenshot: CaptureScreenshotAsFile failed: " + e1); }
        try {
            sc.CaptureScreenshot(String(a.path)); // 异步：帧末写盘
            return ok({ screenshot: a.path, async: true });
        } catch (e2) { last = e2; plog("screenshot: CaptureScreenshot failed: " + e2); }
    }
    throw "ScreenCapture API unavailable in this editor build (" + last + "); use OS-level window capture (e.g. PowerShell CopyFromScreen) instead";
};

// internal for tests: expose bridge log tail
COMMANDS.bridge_log = function (a) {
    var n = a && a.tail ? a.tail : 40;
    return ok(Bridge.logLines.slice(-n));
};

function findChild(content, target) {
    // supports plain name or "a/b/c" path
    if (target.indexOf("/") >= 0) return content.GetChildByPath(target);
    return content.GetChild(target);
}

function setOneProp(obj, k, v) {
    if (obj.docElement != null) {
        try {
            obj.docElement.SetProperty(k, String(v));
            return "set";
        } catch (e1) {
            try {
                obj.docElement.SetExtensionProperty(k, String(v));
                return "ext";
            } catch (e2) { /* direct assignment below */ }
        }
    }
    return setDirectProp(obj, k, v);
}

function setDirectProp(obj, k, v) {
    if (k === "xy" && typeof v === "string" && v.indexOf(",") >= 0) {
        var xy = v.split(",");
        obj.x = parseFloat(xy[0]) || 0;
        obj.y = parseFloat(xy[1]) || 0;
        return "x/y";
    }
    if (k === "size" && typeof v === "string" && v.indexOf(",") >= 0) {
        lockSize(obj, v);
        return "w/h";
    }
    if (k === "color" || k === "titleColor") {
        obj.color = unityColor(v);
        return "color";
    }
    if (k === "strokeColor") {
        obj.stroke = true;
        obj.strokeColor = unityColor(v);
        return "color";
    }
    if (k === "strokeSize") {
        obj.stroke = true;
        obj.strokeSize = parseFloat(v) || 0;
        return "strokeSize";
    }
    if (k === "fontSize" || k === "lineGap" || k === "colGap" || k === "lineItemCount") {
        obj[k] = parseFloat(v) || 0;
        return k;
    }
    if (k === "bold" || k === "singleLine" || k === "stroke") {
        obj[k] = v === true || v === "true";
        return k;
    }
    obj[k] = v;
    return "field";
}

function fobjectType(tag) {
    var type = String(tag);
    if (type === "richtext") return FairyEditor.FObjectType.RICHTEXT;
    if (type === "text") return FairyEditor.FObjectType.TEXT;
    if (type === "loader") return FairyEditor.FObjectType.LOADER;
    if (type === "list") return FairyEditor.FObjectType.LIST;
    if (type === "graph") return FairyEditor.FObjectType.GRAPH;
    return type;
}

function attachDocElement(doc, obj) {
    try {
        if (obj.docElement != null) return;
        obj._docElement = new FairyEditor.View.DocElement(doc, obj, false);
    } catch (e) {
        plog("docElement attach skipped: " + e);
    }
}

function unityColor(c) {
    var s = String(c).replace("#", "");
    if (s.length < 6) throw "bad color " + c;
    var rgb = parseInt(s.substring(0, 6), 16);
    try { return FairyGUI.Utils.ToolSet.ColorFromRGB(rgb); } catch (e) { }
    return new CS.UnityEngine.Color(
        parseInt(s.substring(0, 2), 16) / 255,
        parseInt(s.substring(2, 4), 16) / 255,
        parseInt(s.substring(4, 6), 16) / 255,
        1);
}

function lockSize(obj, sizeText) {
    var wh = String(sizeText).split(",");
    var w = parseFloat(wh[0]);
    var h = parseFloat(wh[1]);
    try { obj.autoSize = "none"; } catch (e) { }
    obj.width = w;
    obj.height = h;
    try { obj.initWidth = w; obj.initHeight = h; } catch (e2) { }
}

function applyChildAttrs(obj, attrs) {
    if (attrs.name) obj.name = String(attrs.name);
    if (attrs.id) { try { obj.id = String(attrs.id); } catch (eId) { } }
    if (attrs.autoSize) { try { obj.autoSize = String(attrs.autoSize); } catch (eAs) { } }
    else if (attrs.size) { try { obj.autoSize = "none"; } catch (eAs2) { } }
    if (attrs.singleLine === "true") { try { obj.singleLine = true; } catch (eSl) { } }
    if (attrs.bold === "true") { try { obj.bold = true; } catch (eB) { } }
    if (attrs.text != null) obj.text = String(attrs.text);
    if (attrs.fontSize != null) obj.fontSize = parseFloat(attrs.fontSize) || obj.fontSize;
    if (attrs.color) obj.color = unityColor(attrs.color);
    if (attrs.strokeColor || attrs.strokeSize != null) {
        obj.stroke = true;
        if (attrs.strokeColor) obj.strokeColor = unityColor(attrs.strokeColor);
        if (attrs.strokeSize != null) obj.strokeSize = parseFloat(attrs.strokeSize) || 0;
    }
    if (attrs.align) { try { obj.align = String(attrs.align); } catch (eA) { } }
    if (attrs.vAlign) { try { obj.verticalAlign = String(attrs.vAlign); } catch (eV) { } }
    if (attrs.xy) setDirectProp(obj, "xy", attrs.xy);
    if (attrs.size) lockSize(obj, attrs.size);
    if (attrs.url) { try { obj.url = String(attrs.url); } catch (eU) { } }
    if (attrs.defaultItem) obj.defaultItem = String(attrs.defaultItem);
    if (attrs.layout) obj.layout = String(attrs.layout);
    if (attrs.lineGap != null) obj.lineGap = parseFloat(attrs.lineGap) || 0;
    if (attrs.colGap != null) obj.colGap = parseFloat(attrs.colGap) || 0;
    if (attrs.lineItemCount != null) obj.lineItemCount = parseFloat(attrs.lineItemCount) || 0;
    if (attrs.overflow) { try { obj.overflow = String(attrs.overflow); } catch (eO) { } }
    if (attrs.fill) { try { obj.fill = String(attrs.fill); } catch (eF) { } }
}

function applyProps(obj, props) {
    var applied = [];
    for (var k in props) {
        applied.push(k + ":" + setOneProp(obj, k, propValueIn(props[k])));
    }
    return applied;
}

// ---------------- publish (async across frames) ----------------

function startPublish(job) {
    var pkg = getPkg(job.args.pkg);
    var handler = new FairyEditor.PublishHandler(pkg, job.args.branch || "");
    if (job.args.out_path) handler.exportPath = String(job.args.out_path);
    job.handler = handler;
    job.done = false;
    job.files = [];
    handler.add_onComplete(function () {
        job.done = true;
        job.isSuccess = handler.isSuccess;
        job.exportPath = handler.exportPath;
        try {
            var files = CS.System.IO.Directory.GetFiles(handler.exportPath);
            for (var i = 0; i < files.Length; i++) job.files.push(files.GetValue(i));
        } catch (e) { }
    });
    var t0 = Date.now();
    job.t0 = t0;
    handler.Run(); // hot task; onComplete marks completion
    job.deadline = t0 + (job.args.timeout_ms || 120000);
}

function stepPublish(job) {
    if (job.done) {
        return ok({ isSuccess: job.isSuccess, elapsedMs: Date.now() - job.t0, files: job.files });
    }
    if (Date.now() > job.deadline) {
        try { job.handler.Exit(); } catch (e) { }
        return fail("publish timed out after " + (Date.now() - job.t0) + "ms");
    }
    return null; // keep waiting, called again next frame
}

// ---------------- async command registry ----------------

var ASYNC_STARTERS = { publish: startPublish };
var ASYNC_STEPPERS = { publish: stepPublish };

// ---------------- instance registry (multi-project support) ----------------
// A fixed per-user registry file maps running editor instances to their
// ports, so agents can tell several open projects apart.

var RegistryPath = (function () {
    try {
        return CS.System.Environment.GetFolderPath(CS.System.Environment.SpecialFolder.UserProfile)
            + "/.fgui-agent-bridge/registry.json";
    } catch (e) { return null; }
})();

function registryRead() {
    if (RegistryPath == null) return [];
    try {
        var s = CS.System.IO.File.ReadAllText(RegistryPath);
        var arr = JSON.parse(s);
        return Array.isArray(arr) ? arr : [];
    } catch (e) { return []; }
}

function registryWrite(arr) {
    if (RegistryPath == null) return;
    try {
        CS.System.IO.Directory.CreateDirectory(
            CS.System.IO.Path.GetDirectoryName(RegistryPath));
        CS.System.IO.File.WriteAllText(RegistryPath, JSON.stringify(arr));
    } catch (e) { plog("registry write failed: " + e); }
}

function registryRegister(port) {
    // System.Diagnostics.Process reflection can crash the stripped Unity build.
    // HTTP discovery proves liveness; the editor only records its own endpoint.
    var arr = registryRead().filter(function (e) { return e.port !== port; });
    var entry = {
        port: port,
        url: "http://127.0.0.1:" + port + "/",
        project: projectLabel(),
        projectPath: projectDirectory(),
        startedAt: new Date().toISOString()
    };
    arr.push(entry);
    // Independent files avoid lost registrations when two editors start together.
    try {
        var folder = CS.System.IO.Path.GetDirectoryName(RegistryPath) + '/instances';
        CS.System.IO.Directory.CreateDirectory(folder);
        CS.System.IO.File.WriteAllText(folder + '/' + port + '.json', JSON.stringify(entry));
    } catch (e) { plog('instance registration failed: ' + e); }
    registryWrite(arr);
    return entry;
}

function registryUnregister() {
    var arr = registryRead().filter(function (e) { return e.port !== Bridge.port; });
    registryWrite(arr);
    try {
        var file = CS.System.IO.Path.GetDirectoryName(RegistryPath) + '/instances/' + Bridge.port + '.json';
        if (CS.System.IO.File.Exists(file)) CS.System.IO.File.Delete(file);
    } catch (e) { }
}

function projectDirectory() {
    // The plugin is installed at <project>/plugins/agent-bridge.
    // Avoid additional native Path overloads in the stripped Unity editor build.
    return String(PluginDir).replace(/\\/g, '/').replace(/\/$/, '').split('/').slice(0, -2).join('/');
}

function projectLabel() {
    try {
        if (App.project != null) {
            var n = App.project.name;
            if (n) return String(n);
        }
    } catch (e) { }
    return "";
}

// ---------------- HTTP plumbing (main thread only) ----------------

function startServer() {
    var wanted = readPort();
    var maxTries = 21; // e.g. 7531..7551
    for (var port = wanted; port < wanted + maxTries; port++) {
        try {
            var listener = new CS.System.Net.HttpListener();
            // Prefer 127.0.0.1 on Windows: "localhost" often binds [::1] only,
            // while Node/MCP clients dial 127.0.0.1 or hang on IPv6 Happy Eyeballs.
            // Do not also bind "localhost": on Windows that prefix is IPv6-only and,
            // together with 127.0.0.1, makes discover_projects report the same project twice.
            listener.Prefixes.Add("http://127.0.0.1:" + port + "/");
            listener.Start();
            Bridge.listener = listener;
            Bridge.port = port;
            Bridge.pendingAccept = listener.BeginGetContext(null, null);
            Bridge.tickCount = 0;
            var entry = registryRegister(port);
            plog("listening on http://127.0.0.1:" + port + "/ v" + VERSION
                + (port !== wanted ? " (default port busy, auto-picked)" : ""));
            return true;
        } catch (e) {
            // port busy or listener error - try the next port
            plog("listen try " + port + " failed: " + e);
        }
    }
    plog("FAILED to start http listener on ports " + wanted + ".." + (wanted + maxTries - 1));
    return false;
}

function readBody(ctx) {
    var req = ctx.Request;
    if (req.ContentLength64 <= 0) return "";
    var ms = new CS.System.IO.MemoryStream();
    req.InputStream.CopyTo(ms);
    ms.Position = 0;
    var sr = new CS.System.IO.StreamReader(ms);
    var s = sr.ReadToEnd();
    sr.Close();
    return s;
}

function writeResponse(ctx, status, obj) {
    try {
        var resp = ctx.Response;
        var body = JSON.stringify(obj);
        resp.StatusCode = status;
        resp.ContentType = "application/json; charset=utf-8";
        resp.Headers.Set("Access-Control-Allow-Origin", "*");
        // no ContentLength64 => chunked; avoids Encoding.GetBytes whose
        // string overload is stripped in the editor's Unity runtime
        var sw = new CS.System.IO.StreamWriter(resp.OutputStream);
        sw.Write(body);
        sw.Flush();
        sw.Close();
    } catch (e) {
        plog("writeResponse failed (client gone?): " + e);
    }
}

function pumpAccepts() {
    if (Bridge.pendingAccept == null) return;
    if (!Bridge.pendingAccept.IsCompleted) return;
    var ctx = null;
    try {
        ctx = Bridge.listener.EndGetContext(Bridge.pendingAccept);
    } catch (e) {
        plog("EndGetContext error: " + e);
    }
    // immediately re-arm for the next request
    try {
        Bridge.pendingAccept = Bridge.listener.BeginGetContext(null, null);
    } catch (e) {
        Bridge.pendingAccept = null;
        plog("re-arm failed, server down: " + e);
    }
    if (ctx == null) return;
    handleRequest(ctx);
}

function handleRequest(ctx) {
    var req = ctx.Request;
    // simple CORS preflight support for browser consoles
    if (req.HttpMethod === "OPTIONS") {
        ctx.Response.Headers.Set("Access-Control-Allow-Origin", "*");
        ctx.Response.Headers.Set("Access-Control-Allow-Methods", "POST, OPTIONS");
        ctx.Response.Headers.Set("Access-Control-Allow-Headers", "Content-Type");
        writeResponse(ctx, 200, ok({ cors: true }));
        return;
    }
    var body = "";
    try { body = readBody(ctx); } catch (e) { writeResponse(ctx, 400, fail("bad body: " + e)); return; }
    var msg = null;
    try { msg = body ? JSON.parse(body) : {}; } catch (e) { }
    if (!msg || !msg.cmd) {
        writeResponse(ctx, 400, fail("body must be JSON like {\"cmd\":..., \"args\":{...}}"));
        return;
    }
    Bridge.queue.push({ ctx: ctx, cmd: String(msg.cmd), args: msg.args || {} });
}

function stepQueue() {
    // finish the running async job first
    if (Bridge.current != null) {
        var job = Bridge.current;
        var out = ASYNC_STEPPERS[job.cmd](job);
        if (out !== null && out !== undefined) {
            writeResponse(job.ctx, 200, out);
            Bridge.current = null;
        }
        return; // one async job at a time
    }
    var next = Bridge.queue.shift();
    if (next == null) return;
    var cmd = next.cmd;
    if (ASYNC_STARTERS[cmd]) {
        var job = { ctx: next.ctx, cmd: cmd, args: next.args };
        try {
            ASYNC_STARTERS[cmd](job);
            Bridge.current = job;
        } catch (e) {
            writeResponse(next.ctx, 200, fail(cmd + ": " + e));
        }
        return;
    }
    var fn = COMMANDS[cmd];
    if (fn == null) {
        writeResponse(next.ctx, 404, fail("unknown command: " + cmd + " (see commands in README)"));
        return;
    }
    var result;
    try {
        result = fn(next.args);
    } catch (e) {
        var stack = e && e.stack ? " | " + String(e.stack).split("\n").slice(0, 4).join(" <- ") : "";
        result = fail(cmd + ": " + (e && e.message ? e.message : e) + stack);
    }
    writeResponse(next.ctx, 200, result);
}

function onUpdate() {
    try {
        try { CS.UnityEngine.Application.runInBackground = true; } catch (eBg) { }
        if (Bridge.listener == null) return;
        Bridge.tickCount = (Bridge.tickCount || 0) + 1;
        if (Bridge.tickCount === 1 || Bridge.tickCount % 300 === 0) {
            plog("onUpdate tick=" + Bridge.tickCount
                + " pending=" + (Bridge.pendingAccept != null)
                + " completed=" + (Bridge.pendingAccept != null && Bridge.pendingAccept.IsCompleted)
                + " queue=" + Bridge.queue.length);
        }
        pumpAccepts();
        stepQueue();
    } catch (eUp) {
        plog("onUpdate error: " + eUp);
    }
}

function boot() {
    // keep the frame loop (and thus the HTTP pump) running when the editor
    // window loses focus or is minimized - without this Unity pauses
    try { CS.UnityEngine.Application.runInBackground = true; } catch (e) {
        plog("runInBackground not settable: " + e);
    }
    // Re-assert before the player loop pauses. Setting it only at boot is too late
    // if the host clears the flag when the window loses focus.
    try {
        CS.UnityEngine.Application.add_focusChanged(function (focused) {
            try { CS.UnityEngine.Application.runInBackground = true; } catch (eF) { }
            plog("focusChanged focused=" + focused);
        });
    } catch (eFocus) {
        plog("focusChanged hook skipped: " + eFocus);
    }
    if (App.project != null) {
        startServer();
    } else {
        App.add_onProjectOpened(function () { startServer(); });
    }
    App.add_onUpdate(onUpdate);
    // convenience menu item
    try {
        var toolMenu = App.menu.GetSubMenu("tool");
        toolMenu.AddItem("Agent bridge: restart server", "agentbridge_restart", function () {
            if (Bridge.current != null) {
                plog('restart deferred: a command is still running');
                return;
            }
            try { if (Bridge.listener != null) Bridge.listener.Close(); } catch (e) { }
            Bridge.listener = null;
            Bridge.pendingAccept = null;
            try { registryUnregister(); } catch (e) { }
            startServer();
        });
    } catch (e) {
        plog("menu hook skipped: " + e);
    }
}

boot();

function onDestroy() {
    try { registryUnregister(); } catch (e) { }
    try { if (Bridge.listener != null) Bridge.listener.Close(); } catch (e) { }
}

